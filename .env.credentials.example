################################################################################
#                     TEMPLATE - INFORMATIONS CONFIDENTIELLES                 #
#                                                                              #
#  Ce fichier est un TEMPLATE. Copier ce fichier vers .env.credentials       #
#  et remplir avec les vraies valeurs. NE JAMAIS commiter .env.credentials   #
################################################################################

# Date de dernière mise à jour : [DATE]
# Projet : StacyMakeupCreations

################################################################################
#                             CONNEXION SSH                                   #
################################################################################

## Serveur de Production
SSH_PRODUCTION_HOST=[IP_DU_SERVEUR]
SSH_PRODUCTION_PORT=[PORT_SSH]
SSH_PRODUCTION_USER=[USERNAME]
SSH_PRODUCTION_PASSWORD=[PASSWORD]

# Commande de connexion SSH :
# ssh -p [PORT] [USER]@[HOST]

# Chemins importants sur le serveur :
# - Application : /path/to/application
# - Logs : /path/to/logs

################################################################################
#                        BASE DE DONNÉES PRODUCTION                           #
################################################################################

## Base de données MySQL - Production
DB_PRODUCTION_HOST=[HOST]
DB_PRODUCTION_PORT=[PORT]
DB_PRODUCTION_NAME=[DATABASE_NAME]
DB_PRODUCTION_USER=[USERNAME]
DB_PRODUCTION_PASSWORD=[PASSWORD]

# Connexion string complète :
DATABASE_URL_PRODUCTION="mysql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]"

# Accès phpMyAdmin (si disponible) :
# URL : [URL_PHPMYADMIN]

################################################################################
#                        BASE DE DONNÉES LOCALE                               #
################################################################################

## Base de données MySQL - Local
DB_LOCAL_HOST=[HOST]
DB_LOCAL_PORT=[PORT]
DB_LOCAL_NAME=[DATABASE_NAME]
DB_LOCAL_USER=[USERNAME]
DB_LOCAL_PASSWORD=[PASSWORD]

# Connexion string complète :
DATABASE_URL_LOCAL="mysql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]"

################################################################################
#                          IDENTIFIANTS ADMIN                                 #
################################################################################

## Compte Admin de l'application
ADMIN_EMAIL=[EMAIL]
ADMIN_PASSWORD=[PASSWORD]

# URL d'accès admin :
# Production : https://[DOMAIN]/admin
# Local : http://localhost:[PORT]/admin

################################################################################
#                         AUTRES INFORMATIONS                                 #
################################################################################

## Domaine
DOMAIN_NAME=[DOMAIN]
DOMAIN_PROVIDER=[PROVIDER]

## SSL/HTTPS
SSL_ENABLED=[true/false]
SSL_PROVIDER=[PROVIDER]

################################################################################
#                         COMMANDES UTILES                                    #
################################################################################

# Connexion SSH au serveur :
# sshpass -p '[PASSWORD]' ssh -p [PORT] [USER]@[HOST]

# Connexion MySQL depuis le serveur :
# mysql -u [USER] -p'[PASSWORD]' [DATABASE]

# Vider le cache en production (via SSH) :
# cd [PATH] && php bin/console cache:clear --env=prod

# Backup de la base de données (via SSH) :
# mysqldump -u [USER] -p'[PASSWORD]' [DATABASE] > backup_$(date +%Y%m%d).sql

################################################################################
#                            NOTES IMPORTANTES                                #
################################################################################

# 1. Copier ce fichier vers .env.credentials et remplir les valeurs
# 2. Ne JAMAIS commiter .env.credentials dans Git
# 3. Garder une copie sécurisée dans un gestionnaire de mots de passe
# 4. Changer régulièrement les mots de passe pour la sécurité
# 5. En cas de compromission, changer immédiatement tous les accès

################################################################################