                        </a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" href="#about" role="menuitem">
                            <i class="fas fa-user me-1" aria-hidden="true"></i>
                            <span>À propos</span>
                        </a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" href="mailto:stacy.laplace64@gmail.com" role="menuitem" 
                           aria-label="Envoyer un email à stacy.laplace64@gmail.com">
