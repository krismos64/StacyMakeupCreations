<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}StacyMakeupCreations - Artiste Maquillage Professionnel{% endblock %}</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="{% block meta_description %}Portfolio professionnel de créations artistiques de maquillage et nail art par Stacy Laplace. Découvrez des looks uniques, audacieux et créatifs pour tous vos événements.{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}maquillage, nail art, maquilleuse professionnelle, makeup artist, beauté, cosmétiques, ongles, mariage, événementiel, France{% endblock %}">
    <meta name="author" content="Stacy Laplace - StacyMakeupCreations">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    
    <!-- Viewport et responsivité -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="theme-color" content="#667eea">
    <meta name="color-scheme" content="dark light">
    
    <!-- Favicons -->
    <link rel="icon" href="{{ asset('assets/icon/icon.ico') }}" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('assets/icon/icon.ico') }}">
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
    <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('assets/img/logo5.png')) }}{% endblock %}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}">
    <meta property="og:site_name" content="StacyMakeupCreations">
    <meta property="og:locale" content="fr_FR">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('og_title') }}">
    <meta name="twitter:description" content="{{ block('og_description') }}">
    <meta name="twitter:image" content="{{ block('og_image') }}">
    <meta name="twitter:creator" content="@stacymakeup">
    
    <!-- Données structurées Schema.org -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "{% block schema_type %}Person{% endblock %}",
        "name": "Stacy Laplace",
        "alternateName": "StacyMakeupCreations",
        "jobTitle": "Maquilleuse Professionnelle",
        "description": "Artiste maquillage professionnelle spécialisée en maquillage artistique, nail art et événementiel en France",
        "url": "{{ app.request.schemeAndHttpHost }}",
        "image": "{{ absolute_url(asset('assets/img/logo5.png')) }}",
        "email": "stacy.laplace64@gmail.com",
        "address": {
            "@type": "PostalAddress",
            "addressCountry": "FR"
        },
        "sameAs": [
            "#",
            "#",
            "#"
        ],
        "offers": {
            "@type": "Offer",
            "category": "Maquillage & Nail Art"
        }
    }
    </script>

    <!-- Performance et préchargement -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link rel="dns-prefetch" href="//fonts.gstatic.com">
    <link rel="dns-prefetch" href="//cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Préchargement des ressources critiques -->
    <link rel="preload" href="{{ asset('assets/css/style.css') }}" as="style">
    <link rel="preload" href="{{ asset('assets/js/script.js') }}" as="script">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" as="style">

    {% block stylesheets %}
        <!-- Fonts modernes avec display=swap pour éviter FOIT -->
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        
        <!-- Bootstrap et style principal -->
        <link href="{{ asset('assets/css/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet">
        
        <!-- Icons Font Awesome avec préchargement -->
        <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
        <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
    {% endblock %}
</head>
<body>
    <!-- Particles d'arrière-plan -->
