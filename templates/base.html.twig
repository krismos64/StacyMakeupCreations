                            <i class="fab fa-tiktok fa-lg" aria-hidden="true"></i>
                        </a>
                        <a href="mailto:stacy.laplace64@gmail.com" aria-label="Envoyer un email à stacy.laplace64@gmail.com" role="listitem">
                            <i class="fas fa-envelope fa-lg" aria-hidden="true"></i>
