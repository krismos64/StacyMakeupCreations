{% extends 'base.html.twig' %}

{% block title %}StacyMakeupCreations - Portfolio Artistique{% endblock %}

{% block meta_description %}Découvrez le portfolio de Stacy, artiste maquillage professionnel. Créations uniques, maquillage artistique et nail art créatif.{% endblock %}

{% block body %}
<!-- Hero Section Futuriste -->
<section class="hero">
    <div class="hero-content">
        <h1 class="floating">
            <i class="fas fa-palette me-3"></i>
            StacyMakeupCreations
        </h1>
        <p class="lead">
            Artiste maquillage passionnée • Créatrice de looks uniques • Innovation & Créativité
        </p>
        <div class="hero-buttons">
            <a href="#creations" class="btn btn-primary">
                <i class="fas fa-images me-2"></i>Découvrir mes créations
            </a>
            <a href="mailto:stacy.laplace64@gmail.com" class="btn btn-secondary">
                <i class="fas fa-envelope me-2"></i>Me contacter
            </a>
        </div>
    </div>
</section>

<!-- Section À propos -->
<section class="section" id="about">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="floating">
                    <img src="{{ asset('assets/img/logo2.png') }}" alt="Stacy Logo" class="img-fluid mb-4" style="max-width: 300px;">
                </div>
            </div>
            <div class="col-lg-6">
                <h2 class="section-title">
                    <i class="fas fa-star me-3"></i>
                    Ma Passion, Votre Beauté
                </h2>
                <p class="lead">
                    Bienvenue dans mon univers artistique ! Je suis Stacy, maquilleuse professionnelle passionnée par l'art de sublimer la beauté naturelle.
                </p>
                <p>
                    Chaque création est une œuvre unique, pensée pour révéler votre personnalité et vous faire rayonner. De l'art conceptuel aux looks quotidiens, découvrez un monde où créativité et technique se rencontrent.
                </p>
                <div class="row mt-4">
                    <div class="col-6">
                        <div class="text-center">
                            <h3 class="h4 text-primary">{{ creations|length }}+</h3>
                            <p class="small">Créations réalisées</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <h3 class="h4 text-primary">3+</h3>
                            <p class="small">Années d'expérience</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Créations -->
<section class="section" id="creations">
    <div class="container">
        <h2 class="section-title">
            <i class="fas fa-images me-3"></i>
            Mes Dernières Créations
        </h2>
        <p class="text-center mb-5 opacity-75">
            Explorez mon portfolio et laissez-vous inspirer par mes créations artistiques
        </p>
        
        {% if creations is defined and creations|length > 0 %}
            <div class="creations-grid">
                {% for creation in creations %}
                    <div class="card creation-card">
                        <div class="creation-image-container">
                            <img src="{{ asset('uploads/' ~ creation.image) }}" 
                                 class="creation-image" 
                                 alt="{{ creation.name }}"
                                 loading="lazy">
                            <div class="creation-overlay">
                                <div class="creation-overlay-content">
                                    <h5>{{ creation.name }}</h5>
                                    <p>{{ creation.subtitle }}</p>
                                    <a href="{{ path('app_creation_details', {'slug': creation.slug}) }}" 
                                       class="btn btn-accent btn-sm">
                                        <i class="fas fa-eye me-1"></i>Voir plus
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">{{ creation.name }}</h5>
                            <p class="card-text">{{ creation.subtitle }}</p>
                            <div class="creation-meta">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    {{ creation.createdAt|date('d/m/Y') }}
                                </small>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-5">
                <div class="loading mb-4"></div>
                <h4>Nouvelles créations à venir...</h4>
                <p class="text-muted">Revenez bientôt pour découvrir mes dernières œuvres artistiques !</p>
            </div>
        {% endif %}
    </div>
</section>

<!-- Section Services -->
<section class="section">
    <div class="container">
        <h2 class="section-title">
            <i class="fas fa-magic me-3"></i>
            Mes Services
        </h2>
        
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-palette fa-3x"></i>
                        </div>
                        <h5 class="card-title">Maquillage Artistique</h5>
                        <p class="card-text">Créations uniques et looks conceptuels pour événements spéciaux</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-hand-sparkles fa-3x"></i>
                        </div>
                        <h5 class="card-title">Nail Art</h5>
                        <p class="card-text">Designs créatifs et tendances pour sublimer vos ongles</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-heart fa-3x"></i>
                        </div>
                        <h5 class="card-title">Maquillage Événementiel</h5>
                        <p class="card-text">Mariages, photoshoots et occasions spéciales</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-graduation-cap fa-3x"></i>
                        </div>
                        <h5 class="card-title">Formations</h5>
                        <p class="card-text">Conseils et techniques pour développer vos talents</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Contact -->
<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">
                    <i class="fas fa-envelope me-3"></i>
                    Prête à Créer Ensemble ?
                </h2>
                <p class="lead mb-4">
                    Contactez-moi pour discuter de votre projet et donner vie à vos idées créatives
                </p>
                <a href="mailto:stacy.laplace64@gmail.com" class="btn btn-primary btn-lg">
                    <i class="fas fa-envelope me-2"></i>
                    Me contacter maintenant
                </a>
                
                <div class="social-links mt-4">
                    <a href="#" class="btn btn-outline-light me-3">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="btn btn-outline-light me-3">
                        <i class="fab fa-facebook"></i>
                    </a>
                    <a href="#" class="btn btn-outline-light">
                        <i class="fab fa-tiktok"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
/* Styles spécifiques à la page d'accueil */
.creation-image-container {
    position: relative;
    overflow: hidden;
    border-radius: 15px 15px 0 0;
}

.creation-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(102, 126, 234, 0.9), rgba(240, 147, 251, 0.9));
    opacity: 0;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.creation-card:hover .creation-overlay {
    opacity: 1;
}

.creation-overlay-content h5 {
    color: white;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.creation-overlay-content p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1rem;
}

.service-card {
    height: 100%;
    transition: var(--transition-smooth);
}

.service-card:hover {
    transform: translateY(-5px);
}

.service-icon {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.creation-meta {
    border-top: 1px solid var(--glass-border);
    padding-top: 1rem;
    margin-top: 1rem;
}

.hero-buttons {
    margin-top: 2rem;
}

.hero-buttons .btn {
    margin: 0 0.5rem 1rem 0.5rem;
}

@media (max-width: 768px) {
    .hero h1 {
        font-size: 2.5rem;
    }
    
    .hero-buttons .btn {
        display: block;
        margin: 0.5rem auto;
        max-width: 250px;
    }
}
</style>
{% endblock %}