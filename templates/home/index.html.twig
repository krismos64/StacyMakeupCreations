{% extends 'base.html.twig' %}

{% block title %}StacyMakeupCreations - Portfolio Artistique | Maquilleuse Professionnelle{% endblock %}

{% block meta_description %}Découvrez le portfolio de Stacy Laplace, artiste maquillage professionnel. Créations uniques, maquillage artistique et nail art créatif pour tous vos événements en France.{% endblock %}

{% block meta_keywords %}portfolio maquillage, artiste makeup, nail art professionnel, maquilleuse France, créations artistiques, événementiel beauté{% endblock %}

{% block og_type %}website{% endblock %}

{% block schema_type %}LocalBusiness{% endblock %}

{% block body %}

<!-- Données structurées spécifiques à la page d'accueil -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "StacyMakeupCreations",
    "alternateName": "Stacy Laplace Maquilleuse",
    "description": "Artiste maquillage professionnelle spécialisée en maquillage artistique, nail art et événementiel",
    "url": "{{ app.request.schemeAndHttpHost }}",
    "telephone": "",
    "email": "stacy.laplace64@gmail.com",
    "address": {
        "@type": "PostalAddress",
        "addressCountry": "FR"
    },
    "geo": {
        "@type": "GeoCoordinates",
        "latitude": "43.6043",
        "longitude": "-1.4437"
    },
    "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:00",
        "closes": "19:00"
    },
    "serviceType": ["Maquillage artistique", "Nail art", "Maquillage événementiel", "Formation beauté"],
    "areaServed": {
        "@type": "Country",
        "name": "France"
    },
    "image": "{{ absolute_url(asset('assets/img/logo5.png')) }}",
    "logo": "{{ absolute_url(asset('assets/img/logo5.png')) }}",
    "sameAs": [
        "#",
        "#",
        "#"
    ],
    "founder": {
        "@type": "Person",
        "name": "Stacy Laplace"
    }
}
</script>
<!-- Hero Section Futuriste -->
<section class="hero" role="banner" aria-labelledby="hero-title">
    <div class="hero-content">
        <h1 id="hero-title" class="floating">
            <i class="fas fa-palette me-3" aria-hidden="true"></i>
            <span>StacyMakeupCreations</span>
        </h1>
        <p class="lead" role="doc-subtitle">
            Artiste maquillage passionnée • Créatrice de looks uniques • Innovation & Créativité
        </p>
        <div class="hero-buttons" role="group" aria-label="Actions principales">
            <a href="#creations" class="btn btn-primary" aria-describedby="hero-cta-desc">
                <i class="fas fa-images me-2" aria-hidden="true"></i>
                <span>Découvrir mes créations</span>
            </a>
            <a href="mailto:stacy.laplace64@gmail.com" class="btn btn-secondary" 
               aria-label="Envoyer un email à stacy.laplace64@gmail.com">
                <i class="fas fa-envelope me-2" aria-hidden="true"></i>
                <span>Me contacter</span>
            </a>
        </div>
        <p id="hero-cta-desc" class="sr-only">Explorez le portfolio de créations artistiques de maquillage et nail art</p>
    </div>
</section>

<!-- Section À propos -->
<section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="floating">
                    <img src="{{ asset('assets/img/logo2.png') }}" 
                         alt="Logo StacyMakeupCreations - Palette de maquillage artistique" 
                         class="img-fluid mb-4" 
                         style="max-width: 300px;"
                         loading="lazy"
                         width="300"
                         height="auto">
                </div>
            </div>
            <div class="col-lg-6">
                <header>
                    <h2 id="about-title" class="section-title">
                        <i class="fas fa-star me-3" aria-hidden="true"></i>
                        <span>Ma Passion, Votre Beauté</span>
                    </h2>
                </header>
                <div class="about-content">
                    <p class="lead">
                        Bienvenue dans mon univers artistique ! Je suis <strong>Stacy Laplace</strong>, maquilleuse professionnelle passionnée par l'art de sublimer la beauté naturelle.
                    </p>
                    <p>
                        Chaque création est une œuvre unique, pensée pour révéler votre personnalité et vous faire rayonner. De l'art conceptuel aux looks quotidiens, découvrez un monde où créativité et technique se rencontrent.
                    </p>
                    <div class="row mt-4" role="list" aria-label="Statistiques de l'artiste">
                        <div class="col-6" role="listitem">
                            <div class="text-center">
                                <h3 class="h4 text-primary">
                                    <span aria-label="{{ creations|length }} créations réalisées">{{ creations|length }}+</span>
                                </h3>
                                <p class="small">Créations réalisées</p>
                            </div>
                        </div>
                        <div class="col-6" role="listitem">
                            <div class="text-center">
                                <h3 class="h4 text-primary">
                                    <span aria-label="Plus de 3 années d'expérience">3+</span>
                                </h3>
                                <p class="small">Années d'expérience</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Créations -->
<section class="section" id="creations">
    <div class="container">
        <h2 class="section-title">
            <i class="fas fa-images me-3"></i>
            Mes Dernières Créations
        </h2>
        <p class="text-center mb-5 opacity-75">
            Explorez mon portfolio et laissez-vous inspirer par mes créations artistiques
        </p>
        
        {% if creations is defined and creations|length > 0 %}
            <div class="creations-grid" role="list" aria-label="Portfolio des créations artistiques">
                {% for creation in creations %}
                    <article class="card creation-card" role="listitem" itemscope itemtype="https://schema.org/VisualArtwork">
                        <div class="creation-image-container">
                            <img src="{{ asset('uploads/' ~ creation.image) }}" 
                                 class="creation-image" 
                                 alt="Création {{ creation.name }} - {{ creation.subtitle }} par Stacy Laplace"
                                 loading="lazy"
                                 itemprop="image">
                            <div class="creation-overlay" aria-hidden="true">
                                <div class="creation-overlay-content">
                                    <h5 itemprop="name">{{ creation.name }}</h5>
                                    <p itemprop="description">{{ creation.subtitle }}</p>
                                    <a href="{{ path('app_creation_details', {'slug': creation.slug}) }}" 
                                       class="btn btn-accent btn-sm"
                                       aria-label="Voir les détails de {{ creation.name }}">
                                        <i class="fas fa-eye me-1" aria-hidden="true"></i>
                                        <span>Voir plus</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <header>
                                <h5 class="card-title" itemprop="name">{{ creation.name }}</h5>
                            </header>
                            <p class="card-text" itemprop="description">{{ creation.subtitle }}</p>
                            <div class="creation-meta">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1" aria-hidden="true"></i>
                                    <time datetime="{{ creation.createdAt|date('c') }}" itemprop="dateCreated">
                                        {{ creation.createdAt|date('d/m/Y') }}
                                    </time>
                                </small>
                            </div>
                            <!-- Données structurées pour chaque création -->
                            <script type="application/ld+json">
                            {
                                "@context": "https://schema.org",
                                "@type": "VisualArtwork",
                                "name": "{{ creation.name|escape('js') }}",
                                "description": "{{ creation.subtitle|escape('js') }}",
                                "image": "{{ absolute_url(asset('uploads/' ~ creation.image)) }}",
                                "url": "{{ url('app_creation_details', {'slug': creation.slug}) }}",
                                "dateCreated": "{{ creation.createdAt|date('c') }}",
                                "creator": {
                                    "@type": "Person",
                                    "name": "Stacy Laplace",
                                    "url": "{{ app.request.schemeAndHttpHost }}"
                                },
                                "artMedium": "Maquillage artistique",
                                "genre": "Art corporel"
                            }
                            </script>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-5">
                <div class="loading mb-4"></div>
                <h4>Nouvelles créations à venir...</h4>
                <p class="text-muted">Revenez bientôt pour découvrir mes dernières œuvres artistiques !</p>
            </div>
        {% endif %}
    </div>
</section>

<!-- Section Services -->
<section class="section">
    <div class="container">
        <h2 class="section-title">
            <i class="fas fa-magic me-3"></i>
            Mes Services
        </h2>
        
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-palette fa-3x"></i>
                        </div>
                        <h5 class="card-title">Maquillage Artistique</h5>
                        <p class="card-text">Créations uniques et looks conceptuels pour événements spéciaux</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-hand-sparkles fa-3x"></i>
                        </div>
                        <h5 class="card-title">Nail Art</h5>
                        <p class="card-text">Designs créatifs et tendances pour sublimer vos ongles</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-heart fa-3x"></i>
                        </div>
                        <h5 class="card-title">Maquillage Événementiel</h5>
                        <p class="card-text">Mariages, photoshoots et occasions spéciales</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card service-card text-center">
                    <div class="card-body">
                        <div class="service-icon mb-3">
                            <i class="fas fa-graduation-cap fa-3x"></i>
                        </div>
                        <h5 class="card-title">Formations</h5>
                        <p class="card-text">Conseils et techniques pour développer vos talents</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Contact -->
<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">
                    <i class="fas fa-envelope me-3"></i>
                    Prête à Créer Ensemble ?
                </h2>
                <p class="lead mb-4">
                    Contactez-moi pour discuter de votre projet et donner vie à vos idées créatives
                </p>
                <a href="mailto:stacy.laplace64@gmail.com" class="btn btn-primary btn-lg">
                    <i class="fas fa-envelope me-2"></i>
                    Me contacter maintenant
                </a>
                
                <div class="social-links mt-4">
                    <a href="#" class="btn btn-outline-light me-3">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="btn btn-outline-light me-3">
                        <i class="fab fa-facebook"></i>
                    </a>
                    <a href="#" class="btn btn-outline-light">
                        <i class="fab fa-tiktok"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
/* Styles spécifiques à la page d'accueil */
.creation-image-container {
    position: relative;
    overflow: hidden;
    border-radius: 15px 15px 0 0;
    background: var(--glass-bg);
}

/* Optimisation de la qualité des images */
.creation-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -webkit-font-smoothing: subpixel-antialiased;
    transform: translateZ(0);
}

@media (min-width: 1200px) {
    .creation-image {
        aspect-ratio: 16/12;
    }
}

/* Pour les écrans haute résolution */
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .creation-image {
        image-rendering: auto;
    }
}

.creation-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(102, 126, 234, 0.9), rgba(240, 147, 251, 0.9));
    opacity: 0;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.creation-card:hover .creation-overlay {
    opacity: 1;
}

.creation-overlay-content h5 {
    color: white;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.creation-overlay-content p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1rem;
}

.service-card {
    height: 100%;
    transition: var(--transition-smooth);
}

.service-card:hover {
    transform: translateY(-5px);
}

.service-icon {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.creation-meta {
    border-top: 1px solid var(--glass-border);
    padding-top: 1rem;
    margin-top: 1rem;
}

.hero-buttons {
    margin-top: 2rem;
}

.hero-buttons .btn {
    margin: 0 0.5rem 1rem 0.5rem;
}

@media (max-width: 768px) {
    .hero h1 {
        font-size: 2.5rem;
    }
    
    .hero-buttons .btn {
        display: block;
        margin: 0.5rem auto;
        max-width: 250px;
    }
}
</style>
{% endblock %}