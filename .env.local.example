# .env.local.example - Copier vers .env.local et configurer avec vos vraies valeurs

###> Configuration Locale ###
# Changez l'environnement selon vos besoins (dev, prod, test)
APP_ENV=dev

# Générez un secret unique pour votre application en production
# Utilisez: openssl rand -hex 32
APP_SECRET=votre_secret_unique_ici

###> Base de données ###
# Configuration locale de développement
DATABASE_URL="mysql://root:@127.0.0.1:3306/SMC"

# Configuration de production (à ne PAS committer)
# DATABASE_URL="mysql://username:password@host:port/database_name"

###> Mailer (optionnel) ###
# Configuration pour l'envoi d'emails
# MAILER_DSN=smtp://user:pass@smtp.example.com:587